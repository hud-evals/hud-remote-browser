# Browser provider (optional — auto-detected from whichever API key is set)
# Supported: anchorbrowser, steel, browserbase, hyperbrowser
BROWSER_PROVIDER=""

# Provider API keys (set the one for your provider)
ANCHOR_API_KEY=""
STEEL_API_KEY=""
BROWSERBASE_API_KEY=""
BROWSERBASE_PROJECT_ID=""
HYPERBROWSER_API_KEY=""

# Optional: browser session limits
BROWSER_MAX_DURATION=""
BROWSER_IDLE_TIMEOUT=""

# Google service account for the sheet-from-file (SheetBench) tasks.
# One of: raw/base64 JSON, base64 JSON, or a file path.
GCP_CREDENTIALS_JSON=""
GCP_CREDENTIALS_BASE64=""
GCP_CREDENTIALS_FILE=""

# HUD platform key (deploying / hosted evals)
HUD_API_KEY=""
